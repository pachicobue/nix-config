#!/usr/bin/env bash

export DIRENV_WARN_TIMEOUT=20s

# Load devShell from flake (devenv via flake-parts)
# devenv.root を渡すため、devenv-root 入力をカレントディレクトリで上書きする
watch_file devenv.nix
use flake . --override-input devenv-root "file+file://"<(printf %s "$PWD")

# Extend the environment with per-user overrides
source_env_if_exists .envrc.local
